# Serve DHCP on wlan0 and the OSU VIF when created
interface=wlan0
# OSU VIF will be detected after hostapd starts; we also allow dynamic binds:
#bind-dynamic
dhcp-range=192.168.50.10,192.168.50.200,24h
dhcp-option=option:router,192.168.50.1
dhcp-option=option:dns-server,1.1.1.1
domain=sensora.local
server=1.1.1.1
log-queries
log-dhcp
